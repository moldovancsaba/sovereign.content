{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereigncontent.messmass.com/schemas/fleet-daily-swot.schema.json",
  "title": "FleetDailySwot",
  "type": "object",
  "required": [
    "job",
    "date",
    "executiveBrief",
    "agents",
    "environmentComparison",
    "recommendations"
  ],
  "properties": {
    "job": { "const": "fleet:daily-swot" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "executiveBrief": { "type": "string", "minLength": 40 },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "folder", "swot", "signals", "scores"],
        "properties": {
          "id": { "type": "string" },
          "folder": { "type": "string" },
          "swot": {
            "type": "object",
            "required": ["strengths", "weaknesses", "opportunities", "threats"],
            "properties": {
              "strengths": { "type": "array", "items": { "type": "string" } },
              "weaknesses": { "type": "array", "items": { "type": "string" } },
              "opportunities": { "type": "array", "items": { "type": "string" } },
              "threats": { "type": "array", "items": { "type": "string" } }
            }
          },
          "signals": {
            "type": "object",
            "additionalProperties": true
          },
          "scores": {
            "type": "object",
            "required": [
              "reliability",
              "consistency",
              "efficiency",
              "environmentFit",
              "outcomeNormalized"
            ],
            "properties": {
              "reliability": { "$ref": "#/$defs/scoreOrMissing" },
              "consistency": { "$ref": "#/$defs/scoreOrMissing" },
              "efficiency": { "$ref": "#/$defs/scoreOrMissing" },
              "environmentFit": { "$ref": "#/$defs/scoreOrMissing" },
              "outcomeNormalized": { "$ref": "#/$defs/scoreOrMissing" }
            }
          }
        }
      }
    },
    "environmentComparison": {
      "type": "object",
      "required": ["bestFitFolder", "rationale", "caveats"],
      "properties": {
        "bestFitFolder": {
          "type": ["string", "null"],
          "description": "content.* folder currently best for the working environment, or null if insufficient signal"
        },
        "rationale": { "type": "string" },
        "caveats": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "problem",
          "why",
          "how",
          "evidence",
          "delivery"
        ],
        "properties": {
          "target": { "type": "string" },
          "problem": { "type": "string" },
          "why": { "type": "string" },
          "how": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "delivery": {
            "enum": ["auto", "agent_execute", "hitl_review"]
          }
        }
      }
    },
    "insufficientSignals": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "scoreOrMissing": {
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "note"],
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 100 },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "const": "insufficient_signal" },
            "note": { "type": "string" }
          }
        }
      ]
    }
  }
}
